#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/rgbled_widget.dtsi>

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

#define QWERTY 0
#define DEFAULT 1
#define ARROW_NUM 2
#define SYMBOL 3
#define FUNCTION 4
#define MOUSE 5
#define SYSTEM 6

&mt {                                            // モッドタップの設定(単押し、長押しの切り替えとか)
    flavor = "balanced";                   // hold-preferredは長押しか単押しかあいまいな時は長押しにする。tap-preferredもある。
    tapping-term-ms = <200>;                     // 200msを超えると長押し判定になる。
    quick-tap-ms = <0>;                          // 連打判定を無効化
};

&lt {                                            // レイヤータップの設定(単押し、長押し(レイヤー変更)の切り替えとか)
    flavor = "hold-preferred";                   // hold-preferredは長押しか単押しかあいまいな時は長押しにする。tap-preferredもある。
};

/ {                                              // ここから本体の記述が始まる。

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {                               // triレイヤーの設定
            if-layers = <ARROW_NUM SYMBOL>;       // ARROW_NUMレイヤーとSYMBOLレイヤーを同時押しすると
            then-layer = <FUNCTION>;              // FUNCTION レイヤーが有効になる。
        };
    };

    combos {                                      // 同時押し設定
        compatible = "zmk,combos";

        // esc {
            // bindings = <&kp ESC>;              // 20番キーと21番キーを同時押しするとESC
            // key-positions = <20 21>;           // キーボードを左右合体させて、一番左上が0、右上が9、左下が30、右下が39
            // timeout-ms = <80>;                 // 80ms以内に
        // };

        tab {
            bindings = <&kp TAB>;                 // 1番キーと3番キーを同時押しするとTAB
            key-positions = <11 12>;
            timeout-ms = <80>;                    // 80ms以内に
        };

        // plus {
            // bindings = <&kp PLUS>;             // 16番キーと17番キーを同時押しすると+
            // key-positions = <16 17>;
            // timeout-ms = <80>;                 // 80ms以内に
            // layers = <ARROW_NUM>;              // ARROW_NUMレイヤーで
        // };

        // minus {
            // bindings = <&kp MINUS>;            // 26番キーと27番キーを同時押しすると-
            // key-positions = <26 27>;
            // timeout-ms = <80>;                 // 80ms以内に
            // layers = <ARROW_NUM>;              // ARROW_NUMレイヤーで
        // };

        // astrk {
            // bindings = <&kp ASTRK>;            // 17番キーと18番キーを同時押しすると*
            // key-positions = <17 18>;
            // timeout-ms = <80>;                 // 80ms以内に
            // layers = <ARROW_NUM>;              // ARROW_NUMレイヤーで
        // };

        // slash {
            // bindings = <&kp SLASH>;            // 27番キーと28番キーを同時押しすると/
            // key-positions = <27 28>;
            // timeout-ms = <80>;                 // 80ms以内に
            // layers = <ARROW_NUM>;              // ARROW_NUMレイヤーで
        // };

        // qwerty_on_off {
            // bindings = <&tog QWERTY>;          // 4番キーと5番キーを同時押しするとQWERTYレイヤ―とデフォルトレイヤーを切替  
            // key-positions = <4 5>;
            // timeout-ms = <80>;                 // 80ms以内に
            // layers = <DEFAULT QWERTY>;         // デフォルトレイヤーとQWERTYレイヤーで有効
        // };

        system_on_off {
            bindings = <&mo SYSTEM>;              // 30番キーと31番キーを同時押ししてる間、SYSTEMレイヤーに切り替え  
            key-positions = <30 31>;
            timeout-ms = <80>;                    // 80ms以内に
        };
    };

    behaviors {                                      // ここで新しいbehaviorを定義している
        com_excl: comma_exclamation {                // 新しいbehavior:com_exc1
            compatible = "zmk,behavior-mod-morph";   // mod-morphを使うという意味(mod-morphは修飾キーが押されているのみ別キーに変化する機能)
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp EXCL>;      // kp com_exc1として通常は「,」、シフトを押しながらだと「！」になるbehavior作成した。
            mods = <(MOD_LSFT)>;                     // 何を押しながらかを指定
        };
        dot_qmark: dot_question {                    // 新しいbehavior:dot_qmark
            compatible = "zmk,behavior-mod-morph";   // mod-morphを使うという意味
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp QMARK>;       // kp dot_qmarkとして通常は「.」、シフトを押しながらだと「?」になるbehavior作成した。
            mods = <(MOD_LSFT)>;                     // 何を押しながらかを指定
        };
        fslh_bslh: slash_backslash {                 // 新しいbehavior:fslh_bslh
            compatible = "zmk,behavior-mod-morph";   // mod-morphを使うという意味
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>; // kp fslh_bslhとして通常は「.」、シフトを押しながらだと「?」になるbehavior作成した。
            mods = <(MOD_LSFT)>;                     // 何を押しながらかを指定
        };
        hmql: home_row_mod_qwerty_left {             // ここからホームポジションモッドに関する記述　デフォルトレイヤーでもQWERTYレイヤーでも上から2段目の行をCTRL、ALT、GUI、SHIFとして扱うための記述(すべて長押し)
            compatible = "zmk,behavior-hold-tap";    // タップと長押しで動作を変えるという意味
            #binding-cells = <2>;                    // この動作は2個の引数を受け取るという意味(たとえば「 &hmq1 LCTRL H 」のような感じ)
            flavor = "balanced";
            require-prior-idle-ms = <150>;           // 直前に150ms休止があればタップ優先
            tapping-term-ms = <280>;                 // 280ms以内ならタップとして扱う
            quick-tap-ms = <175>;                    // 素早い連打をタップとして扱う
            bindings = <&qm>, <&kp>;                  
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38 39>;
            hold-trigger-on-release;
        };
        hmqr: home_row_mod_qwerty_right {            // hmqlの右手版
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&qm>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            hold-trigger-on-release;
        };
        hml: home_row_mod_left {                    // hmqlの簡易版　こちらはQWERTYレイヤーで使う
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 35 36 37 38 39>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {                   // hmqrの簡易版 こちらはQWERTYレイヤーで使う
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34>;
            hold-trigger-on-release;
        };
    };

    macros {
        qm: qwerty_m {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &mo QWERTY>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_release &mo QWERTY>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

         QWERTY {
             bindings = < 
                &mt ESCAPE Q       &kp W          &kp E          &kp R                        &kp T                     &kp Y             &kp U            &kp I          &kp O          &kp P
                &kp A              &kp S          &kp D          &kp F                        &kp G                     &kp H             &kp J            &kp K          &kp L          &kp INTERNATIONAL_1
                &mt LEFT_SHIFT Z   &kp X          &kp C          &kp V                        &kp B                     &kp N             &kp M            &kp COMMA      &kp DOT        &mt RSHFT SLASH
                &kp LCTRL          &kp LGUI       &kp LALT       &lt ARROW_NUM INT_HENKAN     &lt SYMBOL SPACE          &kp BACKSPACE     &kp ENTER        &kp MINUS       &kp PLUS       &kp DEL
            >;
        };

        DEFAULT {
            bindings = <

                &kp P            &kp Y           &kp R           &kp G            &kp B                     &fslh_bslh          &kp L            &kp U           &kp Z           &kp Q
                &hmql LCTRL H    &hmql LALT S    &hmql LGUI N    &hml LSHIFT T    &kp K                     &com_excl           &hmr RSHIFT O    &hmqr RGUI A    &hmqr LALT I    &hmqr RCTRL E
                &kp F            &kp W           &kp M           &kp D            &kp J                     &kp MINUS           &dot_qmark       &kp V           &kp C           &kp X
                &qm LCTRL        &qm LALT        &qm LGUI        &kp SPACE        &lt ARROW_NUM LANG2       &lt SYMBOL LANG1    &kp ENTER        &qm RGUI        &qm RALT        &qm RCTRL
            >;
        };
       
        ARROW_NUM {
            bindings = <
                &trans            &kp AMPERSAND  &kp JP_DQUOTE    &kp JP_LPAREN     &kp JP_RPAREN          &kp N7     &kp N8    &kp N9    &kp PLUS           &kp MINUS
                &mt JP_AT         &trans         &kp PERCENT      &kp JP_LBRACKET   &kp JP_RBRACKET        &kp N4     &kp N5    &kp N6    &kp KP_MULTIPLY    &kp KP_DIVIDE
                &kp HASH          &kp COLON      &kp SEMI         &kp EXCLAMATION   &kp QUESTION           &kp N1     &kp N2    &kp N3    &kp DOT            &kp JP_EQUAL
                &trans            &trans         &trans           &trans            &trans                 &trans     &trans    &kp N0    &trans             &trans
            >;
        };

        SYMBOL {
            bindings = <
                &trans       &kp AT       &kp HASH      &kp DLLR    &trans         &trans      &kp PRCNT    &kp CARET     &kp LPAR    &kp RPAR
                &kp TILDE    &kp GRAVE    &kp DQT       &kp SQT     &trans         &kp BSPC    &kp AMPS     &kp PIPE      &kp LBKT    &kp RBKT
                &kp Q        &kp W        &kp COLON     &kp SEMI    &trans         &kp DEL     &ind_bat     &ind_con      &kp LBRC    &kp RBRC
                &trans       &trans       &trans        &trans      &trans         &trans      &trans       &trans        &trans      &trans
            >;
        };

        FUNCTION {
            bindings = <
                &kp LS(LC(LEFT))     &kp LS(LA(LEFT))    &kp LC(LA(UP))      &kp LS(LA(RIGHT))    &kp LS(LC(RIGHT))         &kp C_MUTE    &kp F7    &kp F8    &kp F9    &kp F12
                &kp LS(LA(ENTER))    &kp LC(LA(LEFT))    &kp LC(LA(DOWN))    &kp LC(LA(RIGHT))    &kp LC(LA(ENTER))         &kp BSPC      &kp F4    &kp F5    &kp F6    &kp F11
                &kp C_VOL_DN         &kp C_PREV          &kp C_PP            &kp C_NEXT           &kp C_VOL_UP              &kp DEL       &kp F1    &kp F2    &kp F3    &kp F10
                &trans               &trans              &trans              &trans               &trans                    &trans        &trans    &trans    &trans    &trans
            >;
        };

        MOUSE {
            bindings = <
                &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans
            >;
        };

        SYSTEM {
            bindings = <
                &trans    &trans    &trans    &trans    &trans         &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &trans    &trans    &trans    &trans    &trans         &trans          &trans          &trans          &trans          &trans
                &trans    &trans    &trans    &trans    &trans         &trans          &trans          &trans          &trans          &trans
                &trans    &trans    &trans    &trans    &trans         &trans          &trans          &trans          &bt BT_CLR      &bt BT_CLR_ALL
            >;  
        };
    };
 };
